# AI Hospital Customer Care — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# =============================================================================
# LLM Configuration (Required)
# =============================================================================

# Your OpenAI API key or compatible endpoint API key
OPENAI_API_KEY=your_openai_api_key_here

# Model name or deployment name
# Examples: gpt-4o-mini, gpt-4o, gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini

# Optional: Base URL for OpenAI-compatible endpoints
# Leave blank to use the default OpenAI endpoint.
# Examples:
#   Azure OpenAI: https://YOUR-RESOURCE.openai.azure.com/
#   Local LM Studio: http://127.0.0.1:1234/v1
#   Ollama: http://127.0.0.1:11434/v1
OPENAI_BASE_URL=

# =============================================================================
# Application Configuration (Optional)
# =============================================================================

# Enable structured backend logging for development
# Set to "false" in production — only errors will be logged
# NEVER set to "true" in production environments
DEBUG_MODE=false
